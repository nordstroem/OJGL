{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-x86",
            "displayName": "Windows x86 (Visual Studio)",
            "generator": "Visual Studio 17 2022",
            "architecture": "Win32",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "windows-x86-ninja",
            "displayName": "Windows x86 (Ninja, needed for CrinklerRelease)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build-ninja"
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "windows-x86",
            "configuration": "Debug"
        },
        {
            "name": "optimizeddebug",
            "configurePreset": "windows-x86",
            "configuration": "OptimizedDebug"
        },
        {
            "name": "release",
            "configurePreset": "windows-x86",
            "configuration": "Release"
        },
        {
            "name": "crinklerrelease",
            "configurePreset": "windows-x86-ninja",
            "configuration": "CrinklerRelease"
        }
    ]
}
